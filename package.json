{
  "name": "garam-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "tsc && cf build && npm run prerender",
    "prerender": "cross-env GARAM_PRERENDER=1 vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/api.test.ts",
    "deploy": "npm run build && cf deploy --prebuilt",
    "db:migrate:local": "cf d1 migrations apply b453f836-8bd6-4031-a2e1-57be9db6e27b --local",
    "db:migrate": "cf d1 migrations apply b453f836-8bd6-4031-a2e1-57be9db6e27b"
  },
  "dependencies": {
    "@google/genai": "3.3.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "framer-motion": "13.5.1",
    "lucide-react": "0.546.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
