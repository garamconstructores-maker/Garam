    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.6.2",
    "cf": "1.0.0-rc.1",
    "cross-env": "10.1.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
